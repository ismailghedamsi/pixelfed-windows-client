<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelfedClient.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:PixelfedClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="28,22" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="20"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                <Border
                    Width="88"
                    Height="88"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="44">
                    <Image
                        x:Name="ProfileAvatarImage"
                        Width="88"
                        Height="88"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                    <TextBlock
                        x:Name="ProfileDisplayNameText"
                        FontSize="24"
                        FontWeight="SemiBold"
                        Text="My profile" />
                    <TextBlock
                        x:Name="ProfileUsernameText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="" />
                    <TextBlock
                        x:Name="ProfileBioText"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border
            x:Name="CollectionPermissionPanel"
            Grid.Row="1"
            Padding="14"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Visibility="Collapsed">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Pixelfed’s collection actions need its write permission. The server’s consent page will show the access being requested."
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <Button
                    Grid.Column="1"
                    Click="EnableCollectionAccess_Click"
                    Content="Enable collection actions"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>

        <TextBlock
            x:Name="ProfileStatusText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Loading your profile…"
            TextWrapping="Wrap" />

        <Grid Grid.Row="3">
            <GridView
                x:Name="OwnPostsGridView"
                IsItemClickEnabled="True"
                ItemClick="OwnPostsGridView_ItemClick"
                SelectionMode="None">
                <GridView.Footer>
                    <Button
                        x:Name="LoadMoreProfilePostsButton"
                        Click="LoadMoreProfilePosts_Click"
                        Content="Load more posts"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed" />
                </GridView.Footer>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="5" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Width="204"
                            Height="204"
                            Margin="4"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Grid>
                                <views:PostMediaCarousel
                                    Width="204"
                                    Height="204"
                                    Visibility="{Binding MediaVisibility}" />
                                <Border
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Visibility="{Binding MediaPlaceholderVisibility}">
                                    <TextBlock
                                        Text="{Binding Caption}"
                                        TextWrapping="Wrap" />
                                </Border>
                                <Button
                                    Width="36"
                                    Height="36"
                                    Margin="6"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Content="⋯"
                                    FontSize="20"
                                    ToolTipService.ToolTip="Post collection actions"
                                    AutomationProperties.Name="Post collection actions">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Tag="{Binding}"
                                                Click="AddToCollection_Click"
                                                Text="Add to collection…" />
                                            <MenuFlyoutItem
                                                Tag="{Binding}"
                                                Click="CreateCollection_Click"
                                                Text="Create collection from this post…" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ScrollViewer
                x:Name="PostDetailView"
                Visibility="Collapsed"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" Spacing="12">
                    <Button
                        HorizontalAlignment="Left"
                        Click="BackToGrid_Click"
                        Content="← Back to profile" />
                    <Border
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <StackPanel Spacing="12">
                            <views:PostMediaCarousel
                                MaxHeight="640"
                                HorizontalAlignment="Center"
                                Visibility="{Binding MediaVisibility}" />
                            <views:PostActionsBar Post="{Binding}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Username}" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Padding="10,2"
                                    Content="⋯"
                                    FontSize="20"
                                    ToolTipService.ToolTip="Post actions"
                                    AutomationProperties.Name="Post actions">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Tag="{Binding}"
                                                Click="AddToCollection_Click"
                                                Text="Add to collection…" />
                                            <MenuFlyoutItem
                                                Tag="{Binding}"
                                                Click="CreateCollection_Click"
                                                Text="Create collection from this post…" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding CreatedAtLabel}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
