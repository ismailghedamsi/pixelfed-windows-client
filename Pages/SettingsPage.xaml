<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelfedClient.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PixelfedClient.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="760" Padding="28,22" Spacing="18">
            <TextBlock Style="{StaticResource PixelfedPageTitleStyle}" Text="Settings" />
            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="16">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="Appearance" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose the look that feels right. System follows your Windows theme." TextWrapping="Wrap" />
                    <ComboBox x:Name="ThemeSelector" Header="App theme" Width="260">
                        <ComboBoxItem Content="Use Windows setting" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Feed defaults" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Choose which feed and account types the app selects when you open the feed." />
            <ComboBox
                x:Name="DefaultFeedSelector"
                Header="Default feed"
                SelectionChanged="DefaultFeed_SelectionChanged">
                <ComboBoxItem Content="Local" />
                <ComboBoxItem Content="Home" />
                <ComboBoxItem Content="Followed hashtags" />
            </ComboBox>
            <ComboBox
                x:Name="DefaultAccountTypeSelector"
                Header="Default account type"
                SelectionChanged="DefaultAccountType_SelectionChanged">
                <ComboBoxItem Content="All accounts" />
                <ComboBoxItem Content="Pixelfed accounts" />
                <ComboBoxItem Content="Mastodon accounts" />
            </ComboBox>
            <TextBlock
                x:Name="FeedDefaultsStatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Defaults are saved automatically." />
            <CheckBox
                x:Name="AllowReblogCheckBox"
                Content="Show reblogged posts and allow reblogging"
                Checked="AllowReblog_Changed"
                Unchecked="AllowReblog_Changed" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Off hides posts reblogged by other accounts and the Share / reblog button. Turn this on to show them." />
            <CheckBox
                x:Name="LimitFrequentPostersCheckBox"
                Content="Show at most one post per account every 24 hours"
                Checked="LimitFrequentPosters_Changed"
                Unchecked="LimitFrequentPosters_Changed" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="When enabled, each account’s next older post appears after its previous shown post is at least 24 hours older. This is off by default." />
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Pixelfed instance" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Enter the server where your Pixelfed account lives. The client checks that it exposes Pixelfed’s API before saving it." />
            <TextBox
                x:Name="InstanceAddressTextBox"
                Header="Server address"
                PlaceholderText="pixelfed.social or photos.example" />
            <Button
                x:Name="CheckInstanceButton"
                Click="CheckInstance_Click"
                Content="Check instance"
                HorizontalAlignment="Left" />
            <Button
                Click="SignIn_Click"
                Content="Select instance and sign in"
                HorizontalAlignment="Left" />
            <TextBlock
                x:Name="InstanceStatusText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Sign-in is next" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Pixelfed registers client credentials separately on each server. The next step is a browser-based OAuth sign-in with read-only access for the feed." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
