<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelfedClient.Pages.CreatePostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="1360" Padding="28,22" Spacing="18">
            <TextBlock Style="{StaticResource PixelfedPageTitleStyle}" Text="Create a photo post" />
            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Choose a photo, write a description with your caption and hashtags, and optionally add it to a collection when you publish." TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold" Text="Post description (caption and hashtags)" />
            <TextBox x:Name="CaptionTextBox" AcceptsReturn="True" Height="280" MaxLength="2000" PlaceholderText="Write your description and add hashtags…" ScrollViewer.VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top" />
            <Grid ColumnDefinitions="0.9*,1.1*" ColumnSpacing="20">
                <StackPanel Spacing="12">
                    <Button x:Name="ChoosePhotoButton" Click="ChoosePhoto_Click" Content="Choose photo…" HorizontalAlignment="Left" />
                    <TextBlock x:Name="PhotoNameText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No photo selected" TextWrapping="Wrap" />
                    <Border MinHeight="260" MaxHeight="620" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                        <Image x:Name="PhotoPreviewImage" MaxHeight="620" Stretch="Uniform" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock FontWeight="SemiBold" Text="Alt text (photo description)" />
                    <TextBox x:Name="AltTextBox" AcceptsReturn="True" MaxLength="1500" MinHeight="80" PlaceholderText="Describe the photo for people using screen readers (optional)" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="Visibility" />
                    <ComboBox x:Name="VisibilitySelector" SelectedIndex="0">
                        <ComboBoxItem Content="Public" Tag="public" />
                        <ComboBoxItem Content="Unlisted" Tag="unlisted" />
                    </ComboBox>
                    <Border Margin="0,8,0,0" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Add to a collection" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Select a collection or create one. The post will be published first, then added to the collection." TextWrapping="Wrap" />
                            <AutoSuggestBox
                                x:Name="CollectionSearchBox"
                                PlaceholderText="Search collections by name"
                                TextMemberPath="DisplayName"
                                TextChanged="CollectionSearch_TextChanged"
                                SuggestionChosen="CollectionSearch_SuggestionChosen" />
                            <ComboBox x:Name="CollectionSelector" DisplayMemberPath="DisplayName" PlaceholderText="No collection" />
                            <Button x:Name="CreateCollectionButton" Click="CreateCollection_Click" Content="＋ Create a collection" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
            <Button x:Name="PublishButton" Style="{StaticResource PixelfedPrimaryButtonStyle}" Click="Publish_Click" Content="Publish photo" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
