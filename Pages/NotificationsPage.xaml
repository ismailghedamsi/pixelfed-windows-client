<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PixelfedClient.Pages.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="28,22" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock FontSize="10" FontWeight="Bold" CharacterSpacing="110" Foreground="{ThemeResource PixelfedAccentBrush}" Text="YOUR ACTIVITY" />
                <TextBlock Style="{StaticResource PixelfedPageTitleStyle}" Text="Notifications" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Likes, shares, follows, mentions, and other activity." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="MarkAllReadButton" Style="{StaticResource PixelfedPrimaryButtonStyle}" Click="MarkAllRead_Click" Content="Mark all as read" />
                <Button Click="Refresh_Click" Content="Refresh" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,220" ColumnSpacing="10">
            <TextBox x:Name="SearchBox" PlaceholderText="Search notifications" />
            <ComboBox x:Name="CategoryFilter" Grid.Column="1" Header="Filter">
                <ComboBoxItem Content="All activity" />
                <ComboBoxItem Content="Comments" />
                <ComboBoxItem Content="Likes" />
                <ComboBoxItem Content="Follows" />
            </ComboBox>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loading notifications…" TextWrapping="Wrap" />
        <ListView
            x:Name="NotificationsList"
            Grid.Row="3"
            IsItemClickEnabled="True"
            ItemClick="NotificationsList_ItemClick"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10" Padding="18" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                        <Grid ColumnDefinitions="*,Auto" RowSpacing="8">
                            <StackPanel Spacing="3">
                                <TextBlock FontSize="16" FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{Binding ActivityLabel}" TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" IsTextSelectionEnabled="True" Text="{Binding DisplayName}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="{Binding Username}" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" Text="{Binding CreatedAtLabel}" />
                                <TextBlock MaxLines="3" IsTextSelectionEnabled="True" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Visibility="{Binding CaptionVisibility}" />
                            </StackPanel>
                            <Image Grid.Column="1" Width="92" Height="92" Margin="16,0,0,0" Source="{Binding ImageSource}" Stretch="UniformToFill" Visibility="{Binding ImageVisibility}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Button x:Name="LoadMoreButton" Click="LoadMore_Click" Content="Load more notifications" HorizontalAlignment="Center" Visibility="Collapsed" />
            </ListView.Footer>
        </ListView>
    </Grid>
</Page>
