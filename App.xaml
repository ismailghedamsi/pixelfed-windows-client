<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PixelfedClient.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixelfedClient">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FF7657C8</Color>
            <Color x:Key="SystemAccentColorLight1">#FF947DE0</Color>
            <Color x:Key="SystemAccentColorLight2">#FFB9A9EB</Color>
            <Color x:Key="SystemAccentColorLight3">#FFDCCFF7</Color>
            <Color x:Key="SystemAccentColorDark1">#FF6045A4</Color>
            <Color x:Key="SystemAccentColorDark2">#FF49367C</Color>
            <Color x:Key="SystemAccentColorDark3">#FF35265B</Color>
            <SolidColorBrush x:Key="PixelfedAccentBrush" Color="#FF7657C8" />
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="14,8" />
            </Style>
            <Style x:Key="PixelfedPageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="-12" />
            </Style>
            <Style x:Key="PixelfedPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource PixelfedAccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
