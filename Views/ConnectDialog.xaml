<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PixelfedClient.Views.ConnectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Connect to Pixelfed"
    CloseButtonText="Not now">
    <Grid MinWidth="420" MinHeight="250">
        <StackPanel x:Name="InstancePanel" Spacing="14">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Choose the Pixelfed server where your account lives, then sign in. Your password stays on that server. Feed access uses read permission; collection actions use Pixelfed’s broader write permission."
                TextWrapping="Wrap" />
            <TextBox
                x:Name="InstanceAddressTextBox"
                Header="Pixelfed server"
                PlaceholderText="pixelfed.social or photos.example" />
            <Button
                x:Name="ConnectButton"
                Click="ConnectButton_Click"
                Content="Check server and sign in"
                HorizontalAlignment="Left" />
            <TextBlock
                x:Name="StatusText"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="LoginPanel" Visibility="Collapsed" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="LoginStatusText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Sign in to the selected Pixelfed server."
                TextWrapping="Wrap" />
            <controls:WebView2
                x:Name="LoginWebView"
                Grid.Row="1"
                MinHeight="420" />
        </Grid>

        <StackPanel x:Name="SuccessPanel" Visibility="Collapsed" Spacing="12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="You’re connected" />
            <TextBlock
                x:Name="SuccessText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <Button
                Click="DoneButton_Click"
                Content="Done"
                HorizontalAlignment="Left" />
        </StackPanel>
    </Grid>
</ContentDialog>
