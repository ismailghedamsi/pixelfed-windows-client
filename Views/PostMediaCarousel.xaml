<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PixelfedClient.Views.PostMediaCarousel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PixelfedClient.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Visibility="{Binding MediaVisibility}">
        <Image
            x:Name="MediaImage"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            DoubleTapped="MediaImage_DoubleTapped"
            PointerPressed="MediaImage_PointerPressed"
            PointerReleased="MediaImage_PointerReleased"
            Source="{Binding MediaSource}"
            Stretch="Uniform">
            <Image.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Tag="{Binding}"
                        Click="DownloadImage_Click"
                        Text="Download image…" />
                </MenuFlyout>
            </Image.ContextFlyout>
        </Image>
        <Button
            Margin="8,0"
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#CC171923"
            Click="PreviousImage_Click"
            Content="‹"
            FontSize="24"
            Visibility="{Binding PreviousImageVisibility}" />
        <Button
            Margin="8,0"
            Padding="8,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#CC171923"
            Click="NextImage_Click"
            Content="›"
            FontSize="24"
            Visibility="{Binding NextImageVisibility}" />
        <Border
            Margin="0,0,0,12"
            Padding="9,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#CC171923"
            CornerRadius="14"
            IsHitTestVisible="False"
            Visibility="{Binding ImageCounterVisibility}">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{Binding ImageCounterText}" />
        </Border>
    </Grid>
</UserControl>
