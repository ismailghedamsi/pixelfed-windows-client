<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PixelfedClient.Views.CollectionCreationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Create a Pixelfed collection"
    PrimaryButtonText="Done, add this post"
    CloseButtonText="Cancel"
    DefaultButton="Primary">
    <Grid MinWidth="560" MinHeight="560" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Text="Create the collection on Pixelfed in this window. When you’re done, choose “Done, add this post” and the app will add your post to it. A new collection may remain a draft until you publish it on Pixelfed."
            TextWrapping="Wrap" />
        <controls:WebView2
            x:Name="CollectionWebView"
            Grid.Row="1"
            MinHeight="420" />
        <TextBlock
            x:Name="CollectionWebViewStatusText"
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Loading Pixelfed…"
            TextWrapping="Wrap" />
    </Grid>
</ContentDialog>
